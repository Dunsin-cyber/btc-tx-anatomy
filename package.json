    "airdrop": "tsx src/airdrop.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^2.0.0",
    "bitcoinjs-lib": "^7.0.2",
    "ecpair": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
