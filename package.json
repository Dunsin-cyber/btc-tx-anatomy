  "private": true,
  "description": "BitDevs Ibadan live coding: take a Bitcoin transaction apart, write OP_RETURN messages, build and broadcast your own transactions on Mutinynet.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "wallet": "tsx src/wallet.ts",
